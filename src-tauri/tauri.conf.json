{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nutristock",
  "version": "0.1.0",
  "identifier": "com.nutristock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "login",
        "title": "Iniciar Sesión",
        "width": 640,
        "height": 480,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false,
        "visible": true
      },
      {
        "label": "main",
        "title": "NutriStock",
        "width": 1280,
        "height": 720,
        "resizable": true,    
        "visible": false     
      }
    ],

    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
